# Tavily (web research)
TAVILY_API_KEY=your-tavily-api-key-here

# TarqaAI (LLM gateway, OpenAI-compatible)
TARQA_API_KEY=your-tarqa-api-key-here
TARQA_MODEL=your-tarqa-model-name-here
TARQA_MODEL2=your-tarqa-model-name-here
TARQA_MODEL3=your-tarqa-model-name-here

# Comma-separated frontend origins allowed to call this API (CORS).
# Defaults to http://localhost:3000 if unset - see DEPLOY.md for production.
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret required (as the X-Admin-Token header) to call
# POST /api/admin/dedupe-guides. Leave unset locally; set a long random
# value in production. The endpoint always 403s if this isn't set.
ADMIN_TOKEN=